# ASTRA — local environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.

# ---------------------------------------------------------------- Groq (optional)
# The LLM synthesis layer is an ENHANCEMENT. Leave this blank and the platform
# runs exactly as before, using deterministic template synthesis instead.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# ASTRA_GROQ_MODEL=openai/gpt-oss-20b     # strict JSON schema + fastest
# ASTRA_LLM_TIMEOUT=20                    # seconds per request
# ASTRA_LLM_RETRIES=1

# ---------------------------------------------------------------- ingestion (optional)
# DATAGOV_API_KEY=                        # data.gov.in personal key
# ASTRA_LIVE_TIMEOUT=20                   # seconds per live request
# ASTRA_LIVE_BUDGET=60                    # total seconds for a live pull
